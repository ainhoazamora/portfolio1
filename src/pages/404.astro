---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
---

<Base title="Page not found" description="That page does not exist.">
  <div class="wrap page">
    <p class="eyebrow">404</p>
    <h1>That page does not exist</h1>
    <p class="lede">The link may be out of date. These are the main sections of the site.</p>
    <ul class="link-row" style="margin-top:2rem">
      <li><a class="button" href={url('/')}>Home</a></li>
      <li><a class="button" href={url('/research')}>Research</a></li>
      <li><a class="button" href={url('/cv')}>CV</a></li>
      <li><a class="button" href={url('/archive')}>Archive</a></li>
      <li><a class="button" href={url('/contact')}>Contact</a></li>
    </ul>
  </div>
</Base>
