---
import Base from '../layouts/Base.astro';
import { bio, interests, site, toolkits, photography } from '../data/site';
import { url } from '../lib/url';
const research = [
  'Computational criminology',
  'Criminal networks',
  'Financial crime and fraud',
  'Human and organ trafficking',
  'Border security',
  'Cybercrime',
];
const bookshelf = interests.find((i) => i.title === 'Currently reading')!;
---
<Base title="About" current="about" description={`About ${site.name}, ${site.role.toLowerCase()}.`}>
  <div class="wrap page">
    <p class="eyebrow">About</p>
    <h1 class="page-title">Hi, I'm Ainhoa</h1>
    <div class="about-grid">
      <div class="prose">
        {bio.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <aside class="about-side">
        <img
          class="profile-photo"
          src={url('/images/me.jpg')}
          alt="Portrait of Ainhoa Zamora"
        />
     <p class="meta">Currently</p>
        <ul class="side-list">
          <li>Graduate Research Assistant, Stanford University (G3O)</li>
          <li>AI red-teaming volunteer, Humane Intelligence</li>
          <li>Based in Stanford, US / Barcelona, ES</li>
        </ul>
      </aside>
    </div>
    <section class="section" id="interests">
      <h2>Research interests</h2>
      <ul class="tags">
        {research.map((item) => <li class="tag">{item}</li>)}
      </ul>
    </section>
    <section class="section" id="methods">
      <h2>Computational methods</h2>
      <p>
        Self-taught in Python and R, with ongoing work on data visualisation and statistical
        analysis. My master's thesis combined ensembled machine learning methods with network
        analysis, and I now apply similar approaches to tracking generative AI adoption at Stanford.
      </p>
      <ul class="toolkits">
        {
          toolkits.map((tool) => (
            <li>
              <span class="toolkit-name">{tool.label}</span>
              <span class="toolkit-detail">{tool.detail}</span>
            </li>
          ))
        }
      </ul>
    </section>
    <section class="section" id="bookshelf">
      <h2>Bookshelf</h2>
      <ul class="entry-list">
        {bookshelf.items.map((item) => <li>{item}</li>)}
      </ul>
    </section>
    <section class="section" id="photography">
      <h2>Photography</h2>
      <p class="photo-intro">
        Amateur photography bridging visual storytelling and criminological perspectives.
      </p>
      <div class="photo-gallery">
        {
          photography.map((photo) => (
            <figure class="photo-card">
              <img src={url(photo.image)} alt={photo.location} loading="lazy" />
              <figcaption>{photo.location}</figcaption>
            </figure>
          ))
        }
      </div>
      <p class="note">
        These images explore the intersection of visual documentation and criminological inquiry.
      </p>
    </section>
  </div>
</Base>

<style>
  .page-title {
    margin-bottom: 2.6rem;
  }
  .about-grid {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }
  @media (min-width: 52rem) {
    .about-grid {
      grid-template-columns: minmax(0, 1fr) 17rem;
      gap: 4rem;
    }
  }
  .profile-photo {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center;
    margin-bottom: 1.5rem;
    border-radius: 3px;
  }
  .about-side {
    border-top: 1px solid var(--rule);
    padding-top: 1rem;
  }
  .side-list li {
    font-size: 0.9rem;
    color: var(--muted);
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .toolkits {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--rule);
    max-width: var(--measure);
  }
  .toolkits li {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .toolkit-name {
    font-family: var(--mono);
    font-size: 0.82rem;
    letter-spacing: 0.03em;
  }
  .toolkit-detail {
    color: var(--muted);
    font-size: 0.9rem;
    text-align: right;
  }
  .photo-intro {
    color: var(--muted);
    font-size: 0.95rem;
    margin-bottom: 1.5rem;
  }
  .photo-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
    margin: 2rem 0 1.5rem;
  }
  .photo-card {
    margin: 0;
    overflow: hidden;
    border-radius: 3px;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .photo-card:hover {
    transform: scale(1.02);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }
  .photo-card img {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: center;
  }
  .photo-card figcaption {
    padding: 0.85rem;
    font-size: 0.88rem;
    color: var(--muted);
    border-top: 1px solid var(--rule);
    background: var(--paper);
    line-height: 1.4;
  }
  .note {
    color: var(--faint);
    font-size: 0.9rem;
    margin-top: 1.2rem;
  }
</style>
